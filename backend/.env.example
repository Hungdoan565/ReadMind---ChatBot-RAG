# Groq (FREE — get key at https://console.groq.com)
GROQ_API_KEY=gsk_your-groq-key-here

# OpenAI (optional — only needed for RAGAS evaluation)
OPENAI_API_KEY=

# App Settings
APP_NAME=ReadMind
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# LLM Settings (Groq model)
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048

# Embedding (HuggingFace local — no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval
RETRIEVAL_TOP_K=10
RERANK_TOP_N=4

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=52

# Notion (optional — for Module 4)
NOTION_TOKEN=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

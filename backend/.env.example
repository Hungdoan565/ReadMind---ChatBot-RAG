# Groq (FREE — get key at https://console.groq.com)
GROQ_API_KEY=gsk_your-groq-key-here

# OpenAI (optional — only needed for RAGAS evaluation)
OPENAI_API_KEY=

# App Settings
APP_NAME=ReadMind
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# LLM Settings (Groq model)
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048

# Embedding (HuggingFace local — no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAGAS evaluation (chỉ dùng cho cổng chất lượng eval/ — KHÁC embeddings/LLM của app)
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_LLM_MODEL=gpt-4o-mini
RAGAS_EVAL_ROOM_CODE=eval
RAGAS_THRESHOLD_FAITHFULNESS=0.9
RAGAS_THRESHOLD_ANSWER_RELEVANCY=0.8
RAGAS_THRESHOLD_CONTEXT_PRECISION=0.75

# Retrieval
RETRIEVAL_TOP_K=10
RERANK_TOP_N=4

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=52

# Notion (optional — for Module 4)
NOTION_TOKEN=

# CORS
# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://readmind:readmind_dev@localhost:5432/readmind
DATABASE_URL_SYNC=postgresql+psycopg://readmind:readmind_dev@localhost:5432/readmind

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_URL=redis://localhost:6379/1

# Auth (JWT)
JWT_SECRET=CHANGE-ME-IN-PRODUCTION
JWT_LIFETIME_SECONDS=3600
JWT_REFRESH_LIFETIME_SECONDS=604800

# Feature flags
USE_CHROMA=false

# OCR (optional)
OCR_ENABLED=true
TESSERACT_CMD=tesseract
